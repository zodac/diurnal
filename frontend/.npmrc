# npm's registry update-notifier ONLY - this is not a version pin.
#
# The npm version is pinned transitively, by the node:X.Y.Z pin: the `FROM node:` stages in the
# Dockerfile and the `node-version` values in .github/workflows/, all bumped as one unit by
# .github/scripts/update_dependency_versions.sh (update_node). `npm ci` and the lockfile regeneration
# in that script both run INSIDE that image on purpose, so the lockfile is written by the exact npm
# that later consumes it.
#
# The notice can therefore only ever advertise an npm DIFFERENT from the one the build uses, and
# acting on it (npm install -g npm@next) would split one pin into two that can disagree - a host npm
# writing a lockfile that the image's npm then reads. npm moves when Node moves; nothing else.
update-notifier=false
