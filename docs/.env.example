# Copy to .env and fill in values before running docker compose

# Timezone — IANA timezone name used by both containers and the Java app
TZ=UTC

# Logging — INFO (default), DEBUG (login events + detailed traces) or TRACE (per-request logging).
# Controls the net.zodac.diurnal.* categories only.
LOG_LEVEL=INFO

# Database query tracing — separate from LOG_LEVEL. WARN (default, off) or TRACE to log every SQL
# statement + bound parameters the app sends to Postgres. Verbose; may expose parameter values.
DB_LOG_LEVEL=WARN

# Application memory sizing. APP_MEM_LIMIT caps the CONTAINER and the JVM heap follows it at 65%, so
# this is the only memory value worth setting - raise it and the heap rises with it. With no limit set
# at all the app sizes itself as though the limit were 2GB, rather than against the whole host, and
# says so at startup.
#
# Diurnal's memory use barely depends on the number of users - there is no server-side per-user cache -
# so what needs headroom is concurrency, and mostly password hashing (each in-flight login holds about
# 19MiB of heap at the default Argon2id cost). 2g suits up to ~10 users; see the Performance Tuning
# section of README.md for larger deployments, and raise it alongside any PASSWORD_HASH_ARGON2_* rise.
# Do not set it below 1792m.
#APP_MEM_LIMIT=2g
# Maximum concurrent blocking requests. Raise alongside APP_MEM_LIMIT, never on its own.
#WORKER_MAX_THREADS=32

# Database
DB_NAME=diurnal_db
DB_USER=diurnal_user
DB_PASSWORD=change-me-strong-password

# PostgreSQL memory sizing. These are the only tuning values that depend on your machine - everything
# else the database is tuned with is hardware-independent and lives in docker-compose.yml.
#
# The defaults below are what the compose file falls back to with none of these set, and are safe from
# roughly 1GB of RAM upwards. On a larger host, raise them: shared_buffers around 25% of RAM,
# effective_cache_size around 50-75%. max_connections is not a limit on users.
#DB_SHARED_BUFFERS=256MB
#DB_EFFECTIVE_CACHE_SIZE=768MB
#DB_WORK_MEM=8MB
#DB_MAINTENANCE_WORK_MEM=128MB
#DB_MAX_CONNECTIONS=25
# 1.1 assumes SSD/NVMe. Set it to 4 if the database lives on a spinning disk.
#DB_RANDOM_PAGE_COST=1.1

# The key every user's notes are encrypted under. It deliberately does NOT live in the database, so a
# dump, backup or replica carries sealed notes and opens none of them - reading one takes the database
# AND this value. It does NOT hide notes from an administrator who has this file; see NOTES.md.
#
# LOSING THIS LOSES EVERY NOTE. There is no recovery. Back it up wherever DB_PASSWORD is backed up, and
# make sure it survives a container rebuild.
#
# Generate with: openssl rand -base64 32
NOTE_ENCRYPTION_KEY=

# Only set while ROTATING the key above, then clear it again. Put the OLD key here and the new one in
# NOTE_ENCRYPTION_KEY, and the next start moves every account across; a start with nothing to rotate does
# nothing. Comma-separated if more than one rotation is in flight.
NOTE_ENCRYPTION_PREVIOUS_KEYS=

# The longest note a user may save, in characters. Default 10,000 (roughly four pages of prose);
# anything from 1 to 100,000 is accepted, and the app refuses to start outside that range.
#
# This bounds no database column - a note is stored encrypted in an unbounded one - so changing it needs
# no migration. What it really sizes is how much the app moves at once: the dashboard loads three months
# of note text in a single response, and searching opens the whole journal. That is why the range stops
# where it does.
#
# LOWERING IT KEEPS EXISTING NOTES. Longer ones stay readable, searchable and exportable, and the note
# box shows them in full; they just cannot be saved again until edited down, and an export containing one
# cannot be re-imported.
NOTE_MAX_LENGTH=10000

# Largest request body the app will accept, in Quarkus MemorySize form - binary suffixes, so 100M is
# 100 MiB (also valid: 512K, 1G, or a plain byte count). This is what bounds an uploaded import
# archive: the Settings > Data card reads the value back and refuses a bigger file in the browser,
# naming this limit, rather than letting the HTTP layer reject it with a bare 413 nothing can explain.
#
# It caps EVERY request body, not only an import, so do not set it near the size of an ordinary form
# post. Lowering it below the app's own 64 MiB decompressed-archive cap is fine - imports are simply
# refused earlier, with the same clear message - so a small host can safely bring it down.
MAX_UPLOAD_SIZE=100M

# Whether each CSV in an exported archive leads with a UTF-8 byte-order mark. It serves one spreadsheet
# and costs another, and the server cannot tell which one opens the download:
#   true  - Excel on Windows reads the file as UTF-8, so accents and emoji survive a double-click.
#           LibreOffice also consumes the mark, but only when its Text Import dialog is set to
#           Unicode (UTF-8); with any other character set it shows the mark in the first header cell.
#   false - plain UTF-8: clean in LibreOffice and in every text tool. Excel on Windows then reads the
#           file in the system code page and mangles anything non-ASCII unless imported via its wizard.
#
# Write side only - the importer strips a leading mark whatever this says, so archives exported under
# either setting import identically and this is safe to change whenever.
EXPORT_CSV_BOM=true

# Host port published by the repository's docker-compose.yml (build-from-source), which reads this
# file via env_file. The container always listens on 8080 internally. NOTE: this is a Compose-level
# setting, not an app setting — docs/docker-compose.example.yml publishes "8080:8080" directly, so
# with that file you change the port by editing its `ports:` mapping instead.
APP_PORT=8080

# Reverse proxy — trust X-Forwarded-* headers (needed for https:// OIDC redirect URIs and Secure
# cookies when a proxy like Traefik terminates TLS). ONLY enable behind a trusted proxy that
# sets/strips these headers; if the app is exposed directly, clients can spoof them. The bundled
# docker-compose.yml defaults this to true because it runs behind Traefik.
TRUST_X_FORWARDED_HEADERS=true

# Update check — once at startup the running version is compared against the latest published GitHub
# release; the result is logged, and if a newer version exists an "Update available" link is shown in
# the admin pages' footer. It is a single best-effort check (never refreshed, so it can go stale over a
# long uptime). Set to false to disable the outbound request entirely (e.g. an air-gapped deployment).
APP_UPDATE_CHECK_ENABLED=true

# --- Authentication ---------------------------------------------------------
# Two sign-in methods: password (local accounts) and OIDC (an identity provider). They can run
# separately or together; at least one must be enabled or the app refuses to start. The very FIRST
# account is always created locally via the setup page, whatever is configured below — it is the
# sysops break-glass administrator (and can change its password even with password login disabled).

# Password sign-in — set to false to disable password login (requires OIDC_ENABLED=true).
PASSWORD_AUTH_ENABLED=true
# Set to false to prevent new password accounts being created via the /register page.
# OIDC accounts are always provisioned automatically on first login regardless of this setting —
# except the very first account (see above).
ENABLE_REGISTRATION=true

# Sessions — server-side; opaque tokens in the `sessions` table (revocable). Lifetimes are ISO-8601.
# A session dies at whichever comes first: idle since last use, or absolute age since creation.
SESSION_IDLE_TIMEOUT=P30D
SESSION_ABSOLUTE_LIFETIME=P90D

# OIDC — set OIDC_ENABLED=true for IdP login (Authorization Code flow).
# Unauthenticated users always land on /login and can choose OIDC or password (if both enabled).
# Register {your-base-url}/ as the callback/redirect URI with your IdP.
OIDC_ENABLED=false
OIDC_ISSUER_URL=https://auth.example.com
OIDC_CLIENT_ID=diurnal
OIDC_CLIENT_SECRET=
# Name shown in the login button: "Log in with <OIDC_PROVIDER_NAME>"
OIDC_PROVIDER_NAME=Authelia
# If true, /login immediately redirects to the OIDC flow (skips the login page).
# Only applies when OIDC_ENABLED=true. Ignored when ?error or ?registered params are present.
OIDC_AUTO_REDIRECT=false
# If true (default), the app probes the IdP discovery endpoint at startup and refuses to boot when
# the provider is unreachable or invalid, so a misconfigured issuer fails the deploy rather than the
# first login. Only applies when OIDC_ENABLED=true. Set false to skip the probe.
OIDC_VERIFY_ON_STARTUP=true
# Extra scopes requested alongside the automatic openid scope (comma-separated). The default asks
# for the non-standard groups scope (Authelia/Keycloak convention); providers that reject unknown
# scopes (e.g. Google) need OIDC_SCOPES=email,profile.
# OIDC_SCOPES=email,profile,groups
# PKCE on the code flow (recommended; on by default). Disable only for a provider that rejects
# PKCE from confidential clients.
# OIDC_PKCE_ENABLED=true
# LDAP/OIDC group names to map to Administrator and User roles.
# When set, group membership in the IdP token controls role on every login (IdP is source of truth).
# When not set, the first registrant becomes Administrator; all others default to User.
# OIDC_ADMIN_GROUP=diurnal-admins
# OIDC_USER_GROUP=diurnal-users
# RP-initiated logout URL — when set, OIDC users are redirected here after logout
OIDC_LOGOUT_URL=https://auth.example.com/logout
