# Build outputs / deps — rebuilt inside the image
target/
frontend/node_modules/
tests/node_modules/
tests/playwright-report/
tests/test-results/

# In-app Settings previews — generated by the `screenshots` stage and copied in from `previews`, never
# taken from the build context. Without this, `COPY src ./src` inherits whatever a developer happens to
# have generated locally, so a GENERATE_PREVIEWS=false build (smoke/perf) is not actually preview-free
# and an out-of-date local set can be baked into the image ahead of the stage's own output.
src/main/resources/META-INF/resources/img/settings/

# Sandbox env (its own build context under sandbox/; not part of the app image)
sandbox/

# Local-only
.env
.git/
.idea/
.vscode/
*.iml
.DS_Store
secrets/
